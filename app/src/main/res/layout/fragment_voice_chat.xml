<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_surface">

    <include
        android:id="@+id/commonHeader"
        layout="@layout/layout_common_header"
        android:layout_width="0dp"
        android:layout_height="@dimen/toolbar_height"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/voiceContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/commonHeader"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_xl">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardConversationSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/md_surface_container_lowest"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:strokeColor="@color/primary_15"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_md">

                    <FrameLayout
                        android:layout_width="@dimen/avatar_md"
                        android:layout_height="@dimen/avatar_md"
                        android:background="@drawable/bg_chip_surface">

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:layout_gravity="center"
                            android:contentDescription="@string/voice_conversation_content_desc"
                            android:src="@android:drawable/ic_menu_agenda"
                            app:tint="@color/md_on_primary_fixed" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvSelectedConversation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/voice_recent_conversation"
                        android:textColor="@color/md_on_surface"
                        android:textSize="@dimen/text_base"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="@dimen/avatar_md"
                        android:layout_height="@dimen/avatar_md"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:layout_gravity="center"
                            android:contentDescription="@string/common_select"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/md_on_primary_fixed" />
                    </FrameLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/md_surface_container_lowest"
                app:cardCornerRadius="@dimen/radius_2xl"
                app:cardElevation="0dp"
                app:strokeColor="@color/primary_10"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_xl"
                    android:paddingTop="@dimen/spacing_xl"
                    android:paddingBottom="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_stage_label"
                        android:textColor="@color/md_primary"
                        android:textSize="@dimen/text_xs"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/voice_status_ready"
                        android:textColor="@color/md_on_surface"
                        android:textSize="@dimen/text_3xl"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStatusSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:gravity="center"
                        android:text="@string/voice_status_subtitle"
                        android:textColor="@color/md_on_surface_variant"
                        android:textSize="@dimen/text_base" />

                    <FrameLayout
                        android:id="@+id/visualizerArea"
                        android:layout_width="@dimen/voice_orb_size"
                        android:layout_height="@dimen/voice_orb_size"
                        android:layout_marginTop="@dimen/spacing_lg">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_voice_soft_circle" />

                        <View
                            android:layout_width="132dp"
                            android:layout_height="132dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_gradient_primary_circle" />

                        <ImageView
                            android:id="@+id/ivMic"
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:layout_gravity="center"
                            android:contentDescription="@string/voice_record"
                            android:src="@android:drawable/ic_btn_speak_now"
                            app:tint="@color/md_on_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/waveformArea"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View android:layout_width="4dp" android:layout_height="16dp" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_wave_bar" />
                        <View android:layout_width="4dp" android:layout_height="24dp" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_wave_bar" />
                        <View android:layout_width="4dp" android:layout_height="36dp" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_wave_bar" />
                        <View android:layout_width="4dp" android:layout_height="28dp" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_wave_bar" />
                        <View android:layout_width="4dp" android:layout_height="40dp" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_wave_bar" />
                        <View android:layout_width="4dp" android:layout_height="28dp" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_wave_bar" />
                        <View android:layout_width="4dp" android:layout_height="36dp" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_wave_bar" />
                        <View android:layout_width="4dp" android:layout_height="24dp" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_wave_bar" />
                        <View android:layout_width="4dp" android:layout_height="16dp" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_wave_bar" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/transcriptCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/md_surface_container_lowest"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_variant_20"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:paddingTop="@dimen/spacing_lg"
                        android:text="@string/voice_history_title"
                        android:textColor="@color/md_on_surface"
                        android:textSize="@dimen/text_base"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerHistory"
                        android:layout_width="match_parent"
                        android:layout_height="136dp"
                        android:clipToPadding="false"
                        android:padding="@dimen/spacing_lg"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:stackFromEnd="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginBottom="@dimen/spacing_lg"
        app:cardBackgroundColor="@color/md_surface_container_lowest"
        app:cardCornerRadius="@dimen/radius_2xl"
        app:cardElevation="4dp"
        app:strokeColor="@color/primary_10"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/controlBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_xl"
            android:paddingVertical="@dimen/spacing_md">

            <FrameLayout
                android:id="@+id/btnStop"
                android:layout_width="@dimen/fab_size"
                android:layout_height="@dimen/fab_size"
                android:background="@drawable/bg_voice_btn"
                android:contentDescription="@string/voice_stop"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:layout_gravity="center"
                    android:contentDescription="@string/voice_stop"
                    android:src="@android:drawable/ic_media_pause"
                    app:tint="@color/md_on_primary_fixed" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnRecord"
                android:layout_width="@dimen/voice_btn_large"
                android:layout_height="@dimen/voice_btn_large"
                android:layout_marginHorizontal="@dimen/spacing_xl"
                android:background="@drawable/bg_gradient_primary"
                android:contentDescription="@string/voice_record"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:layout_gravity="center"
                    android:contentDescription="@string/voice_record"
                    android:src="@android:drawable/ic_btn_speak_now"
                    app:tint="@color/md_on_primary" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnVoiceSettings"
                android:layout_width="@dimen/fab_size"
                android:layout_height="@dimen/fab_size"
                android:background="@drawable/bg_voice_btn"
                android:contentDescription="@string/voice_settings"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:layout_gravity="center"
                    android:contentDescription="@string/voice_settings"
                    android:src="@android:drawable/ic_menu_manage"
                    app:tint="@color/md_on_primary_fixed" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>